# ═══════════════════════════════════════════════════════════════════════
# SENTINEL — Configuration d'Environnement (.env)
# ═══════════════════════════════════════════════════════════════════════

# ─── Discord ───────────────────────────────────────────────────────────
# Token de votre Bot Discord (depuis Discord Developer Portal -> Bot -> Token)
DISCORD_TOKEN=COLLE_TON_TOKEN_ICI
# Client ID de votre application Discord (OAuth2)
DISCORD_CLIENT_ID=1553767735702589440
# Client Secret Discord OAuth2 (Portal Discord -> OAuth2 -> Client Secret)
DISCORD_CLIENT_SECRET=ton_client_secret_ici
# URL de redirection OAuth2 (doit correspondre à la configuration du portail Discord)
DISCORD_REDIRECT_URI=http://localhost:8002/callback
# Identifiant de votre serveur Discord principal
DEFAULT_GUILD_ID=1553770224476627094
# Salons optionnels par défaut
LOG_CHANNEL_ID=1553771834036457523
WARROOM_CATEGORY_ID=1553771865300795454

# ─── PostgreSQL (pgvector) ─────────────────────────────────────────────
DATABASE_URL=postgresql://sentinel:sentinel@postgres:5432/sentinel

# ─── Redis ──────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── Sécurité / Crypto ─────────────────────────────────────────────────
# En prod, générez des clés aléatoires : python3 -c "import secrets; print(secrets.token_hex(32))"
HASH_PEPPER=dec75a688eab281b04fa3ebaaaf8ed34e0a1c8751d8a1903ce917bb2974e8252
FEDERATION_PEPPER=e5ed27669dda99bd798a97fc8b9acfe6e9550b4f22f83f222757d4f278f01eb8
SIGNING_KEY_PATH=models/sentinel_ed25519.pem

# ─── Fédération Inter-Serveurs ──────────────────────────────────────────
FEDERATION_API_URL=http://federation_api:8001
FEDERATION_HMAC_MAX_SKEW_SECONDS=120

# ─── Dashboard Modérateur / Vitrine ─────────────────────────────────────
DASHBOARD_PASSWORD=Ozonelareinedebidaxx9876
DASHBOARD_SECRET_KEY=c7bd0b1347fd510f1ac6ee57b3c854d80401db77dacac6b511fb16cd4dd6af0d

# ─── Machine Learning ──────────────────────────────────────────────────
LEGITIMACY_MODEL_PATH=models/legitimacy_model.joblib
LEGITIMACY_MIN_TRAINING_SAMPLES=40
